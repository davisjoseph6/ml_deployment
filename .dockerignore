# .dockerignore
#
# Goal:
# - Keep build context small
# - Include ONLY the two production weights inside the image
# - Exclude large runtime dirs and historical model snapshots

# ----------------------------
# Python
# ----------------------------
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ----------------------------
# Git
# ----------------------------
.git/
.gitignore

# ----------------------------
# Runtime artifacts (mounted locally)
# ----------------------------
data/
runs/

# ----------------------------
# Model artifacts
# ----------------------------
# Exclude everything by default
ai_model_artifacts/**

# Re-include directory skeletons
!ai_model_artifacts/
!ai_model_artifacts/yolo_segmentation/
!ai_model_artifacts/segmentation/

# Exclude everything inside those dirs (prevents "versions/" or other files sneaking in)
ai_model_artifacts/yolo_segmentation/*
ai_model_artifacts/segmentation/*

# Include ONLY the two production weights
!ai_model_artifacts/yolo_segmentation/best.pt
!ai_model_artifacts/segmentation/mobile_sam.pt

# ----------------------------
# Misc
# ----------------------------
*.log
.DS_Store

